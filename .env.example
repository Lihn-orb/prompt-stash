# --- Backend mode ---------------------------------------------------------
# No variables set  -> LOCAL mode: the UI persists to browser localStorage and
#                      the HTTP API stays dormant. A fresh clone runs with zero setup.
# Supabase set below -> REMOTE mode: the UI calls /api/prompts, which reads/writes
#                      Supabase on the server. Mode is resolved at runtime.
#
# Optional: force REMOTE mode using the on-disk server file store, without Supabase.
# Useful to exercise the API locally before you have Supabase credentials.
ENABLE_SERVER_API=false
LOCAL_DATA_FILE=.data/prompts.json
SEED_DEMO_DATA=true

# Optional Supabase. Set all three together, then run supabase/migrations/001_prompts.sql.
# Server-only: never rename these to NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PROMPT_STASH_OWNER_ID=

# Optional AI metadata extraction. Content is sent to this provider only when enabled.
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Required for public/Vercel deployment. Localhost works without credentials.
# The browser uses native HTTP Basic authentication; no account system is needed.
WORKSPACE_USERNAME=owner
WORKSPACE_PASSWORD=
# Optional exact public origin behind a reverse proxy (no trailing slash).
APP_ORIGIN=
# External POST /api/prompts: Authorization: Bearer <this key>
PROMPT_STASH_API_KEY=
